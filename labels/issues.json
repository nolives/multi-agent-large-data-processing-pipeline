{
  "version": "issues-v2",
  "note": "Deterministic issue grouping. A complaint or cancellation record joins issue '<topic>.<aspect>', where the aspect is the first one listed for its topic that matches: one of its entities is in the record's entity list (names from labels/entities.json), or one of its patterns (case-insensitive regular expressions) matches the review text. Otherwise 'general'. v2 adds text patterns, written after reading the catch-all issues of the 500-review development run.",
  "topics": {
    "access": [
      {
        "aspect": "login",
        "entities": [
          "login",
          "password"
        ],
        "patterns": [
          "\\bsign(ing|ed)? ?(in|up)\\b",
          "\\bverif",
          "\\botp\\b"
        ]
      },
      {
        "aspect": "account",
        "entities": [
          "account"
        ],
        "patterns": [
          "\\bhack",
          "\\bbanned\\b"
        ]
      }
    ],
    "usability": [
      {
        "aspect": "ads",
        "entities": [
          "ads"
        ]
      },
      {
        "aspect": "shuffle-and-skips",
        "entities": [
          "shuffle",
          "skips"
        ],
        "patterns": [
          "\\b(choose|pick|select|play) (a|any|the|my|specific|certain)( \\w+)? songs?\\b",
          "\\brepeat\\b",
          "\\bloop\\b"
        ]
      },
      {
        "aspect": "queue-and-playlists",
        "entities": [
          "queue",
          "playlists",
          "liked songs"
        ]
      },
      {
        "aspect": "interface",
        "entities": [
          "interface",
          "widget"
        ],
        "patterns": [
          "\\bhome ?(screen|page)\\b",
          "\\bicons?\\b",
          "\\bnavigat",
          "\\buser.?friendly\\b",
          "\\bconfusing\\b"
        ]
      },
      {
        "aspect": "update",
        "entities": [
          "update"
        ]
      }
    ],
    "playback": [
